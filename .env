# ==============================================================================
# ANTI-GRAVITY AI: ENVIRONMENT VARIABLES & SECURITY GUARDRAILS
# 사규 §6 준수: 비밀키, 토큰, DB 계정 하드코딩 절대 금지
# ==============================================================================

# Server Network Config
PORT=8080
HOST=127.0.0.1
DEBUG_MODE=false

# External AI APIs (초안 생성 전용 - 사규 ① 실제 외부 자동 발송 금지)
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY_HERE]
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY_HERE]

# Analytics & Social API (미연동 시 'AWAIT_INTEGRATION' 표기 필수 - 사규 ⑤)
INSTAGRAM_GRAPH_API_TOKEN=[YOUR_INSTAGRAM_API_TOKEN_HERE]
YOUTUBE_DATA_API_KEY=[YOUR_YOUTUBE_API_KEY_HERE]

# Output Deliverables Storage (사규 ④ 원본 보존 복제본 원칙)
OUTPUT_DIR=./output
LOGS_DIR=./logs

# 깃허브 자동 연동 설정 (추가할 부분)
GITHUB_TOKEN=ghp_my_github_token
GITHUB_USERNAME=my_github_id
